<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Note" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <!-- Custom Popup Menu Background -->
    <style name="CustomPopupMenu" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/menu_bg_black</item>
    </style>

    <!-- Custom AlertDialog Style -->
    <style name="BlackAlertDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">@color/popup_background</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Bottom Sheet -->
    <style name="CustomBottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheet</item>
    </style>

    <style name="CustomBottomSheet" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@color/black</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

</resources>
